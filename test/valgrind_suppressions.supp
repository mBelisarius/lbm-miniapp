# -----------------------------------------------------------------------------
# Dynamic Linker (glibc dlopen / TLS allocation)
# -----------------------------------------------------------------------------
{
   glibc_dl_map_object_deps_malloc_leaks
   Memcheck:Leak
   match-leak-kinds: all
   fun:malloc
   ...
   fun:_dl_map_object_deps
}

{
   glibc_dl_open_worker_malloc_leaks
   Memcheck:Leak
   match-leak-kinds: all
   fun:malloc
   ...
   fun:dl_open_worker*
}

{
   glibc_dlopen_malloc_leaks
   Memcheck:Leak
   match-leak-kinds: all
   fun:malloc
   ...
   fun:dlopen*
}

{
   glibc_dlopen_calloc_leaks
   Memcheck:Leak
   match-leak-kinds: all
   fun:calloc
   ...
   fun:dlopen*
}

{
   glibc_dlopen_worker_calloc_leaks
   Memcheck:Leak
   match-leak-kinds: all
   fun:calloc
   ...
   fun:dl_open_worker*
}

{
   glibc_pthread_create_tls_allocate_dtv
   Memcheck:Leak
   match-leak-kinds: all
   fun:calloc
   ...
   fun:allocate_dtv
}

{
   glibc_pthread_create_dl_allocate_tls
   Memcheck:Leak
   match-leak-kinds: all
   ...
   fun:_dl_allocate_tls
   fun:pthread_create*
}

# -----------------------------------------------------------------------------
# MPI Runtimes (OpenMPI / HPC-X)
# -----------------------------------------------------------------------------
{
   mpi_runtime_leaks
   Memcheck:Leak
   match-leak-kinds: all
   ...
   obj:*/libmpi*.so*
}

{
   mpi_runtime_cond
   Memcheck:Cond
   ...
   obj:*/libmpi*.so*
}

{
   mpi_runtime_value8
   Memcheck:Value8
   ...
   obj:*/libmpi*.so*
}
