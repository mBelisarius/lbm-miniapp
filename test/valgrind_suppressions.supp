# Valgrind memcheck suppressions for LBM Mini-App
# Suppresses known runtime allocations and JIT compiler artifacts from vendor libraries:
# - NVHPC OpenMP runtime and thread tables
# - CUDA and NVIDIA display driver libraries
# - Intel OneAPI OpenCL CPU runtime & embedded Clang/LLVM JIT compiler
# - OpenCL ICD loaders and PoCL drivers
# - glibc dynamic loader / TLS allocations

# -----------------------------------------------------------------------------
# NVHPC & OpenMP runtime thread tables
# -----------------------------------------------------------------------------
{
   nvhpc_openmp_thread_info_tables
   Memcheck:Leak
   match-leak-kinds: all
   fun:malloc
   ...
   fun:initThreadInfoTables
}

{
   nvhpc_openmp_thread_id
   Memcheck:Leak
   match-leak-kinds: all
   fun:malloc
   ...
   fun:initThreadId
}

{
   nvhpc_openmp_hxi_init
   Memcheck:Leak
   match-leak-kinds: all
   fun:malloc
   ...
   fun:hxiInitThreadId
}

{
   nvhpc_openmp_external_thread
   Memcheck:Leak
   match-leak-kinds: all
   fun:malloc
   ...
   fun:*ExternalThreadId*
}

{
   nvhpc_openmp_libnvomp_leaks
   Memcheck:Leak
   match-leak-kinds: all
   ...
   obj:*/libnvomp*.so*
}

{
   nvhpc_openmp_libnvomp_cond
   Memcheck:Cond
   ...
   obj:*/libnvomp*.so*
}

{
   nvhpc_openmp_libnvomp_value8
   Memcheck:Value8
   ...
   obj:*/libnvomp*.so*
}

{
   nvhpc_openmp_libgomp_leaks
   Memcheck:Leak
   match-leak-kinds: all
   ...
   obj:*/libgomp*.so*
}

{
   nvhpc_openmp_libgomp_cond
   Memcheck:Cond
   ...
   obj:*/libgomp*.so*
}

{
   nvhpc_openmp_libgomp_value8
   Memcheck:Value8
   ...
   obj:*/libgomp*.so*
}

